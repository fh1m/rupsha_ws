# Third-party sources Rupsha builds from, pinned. `vcs import src/external < rupsha.repos`
# (src/external is gitignored; build_rupsha.sh runs the import).
repositories:
  ardupilot_gazebo:
    type: git
    url: https://github.com/ArduPilot/ardupilot_gazebo.git
    version: 082a0fe231f6e63bc8d1598f1cba461d9e2ea7f5   # main @ 2026-04-03
