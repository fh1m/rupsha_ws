<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rupsha_sim</name>
  <version>0.1.0</version>
  <description>Rupsha simulation: the Ackermann plant and the board contract in Gazebo Harmonic, plus the previous skid model and ArduRover SITL launch. A package in the same workspace, not a second workspace.</description>
  <maintainer email="fh1m.dev@gmail.com">Muhammad Fahim Faisal</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <exec_depend>rupsha_control</exec_depend>
  <exec_depend>rupsha_interfaces</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>controller_manager</exec_depend>
  <exec_depend>joint_state_broadcaster</exec_depend>
  <exec_depend>velocity_controllers</exec_depend>
  <exec_depend>position_controllers</exec_depend>
  <exec_depend>rupsha_vision</exec_depend>
  <exec_depend>rupsha_localization</exec_depend>
  <exec_depend>rupsha_planner</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>gz_transport_vendor</exec_depend>
  <exec_depend>gz_msgs_vendor</exec_depend>
  <!-- ardupilot_gazebo comes from rupsha.repos into src/external (not in rosdep). -->

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
